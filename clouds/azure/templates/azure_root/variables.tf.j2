variable "subscription_id" {
  type        = string
  description = "Azure subscription ID"
  default     = "{{ subscription_id }}"
}
variable "resource_group_name" {
  type        = string
  description = "Azure resource group name"
  default     = "{{ resource_group_name }}"
}
variable "location" {
  type        = string
  description = "Azure region"
  default     = "{{ location }}"
}
variable "tags" {
  type    = map(string)
  default = {}
}

{% for anc in anchors %}
# ── {{ anc.module_name }} ─────────────────────────────────────────────────────
variable "{{ anc.module_name }}_name" {
  type    = string
  default = "{{ anc.name }}"
}
{% endfor %}

{% for net in vnets %}
# ── {{ net.module_name }} ─────────────────────────────────────────────────────
variable "{{ net.module_name }}_vnet_name" {
  type    = string
  default = "{{ net.vnet_name }}"
}
variable "{{ net.module_name }}_address_space" {
  type    = string
  default = "{{ net.address_space }}"
}
variable "{{ net.module_name }}_subnet_name" {
  type    = string
  default = "{{ net.subnet_name }}"
}
variable "{{ net.module_name }}_subnet_address_prefix" {
  type    = string
  default = "{{ net.subnet_address_prefix }}"
}
{% endfor %}

{% for inf in infras %}
# ── {{ inf.module_name }} ─────────────────────────────────────────────────────
variable "{{ inf.module_name }}_name" {
  type    = string
  default = "{{ inf.name }}"
}
variable "{{ inf.module_name }}_display_name" {
  type    = string
  default = "{{ inf.display_name }}"
}
variable "{{ inf.module_name }}_shape" {
  type    = string
  default = "{{ inf.shape }}"
}
{% if inf.database_server_type %}
variable "{{ inf.module_name }}_database_server_type" {
  type    = string
  default = "{{ inf.database_server_type }}"
}
{% endif %}
{% if inf.storage_server_type %}
variable "{{ inf.module_name }}_storage_server_type" {
  type    = string
  default = "{{ inf.storage_server_type }}"
}
{% endif %}
variable "{{ inf.module_name }}_compute_count" {
  type    = number
  default = {{ inf.compute_count }}
}
variable "{{ inf.module_name }}_storage_count" {
  type    = number
  default = {{ inf.storage_count }}
}
variable "{{ inf.module_name }}_zone" {
  type    = string
  default = "{{ inf.zone }}"
}
{% endfor %}

{% for cl in clusters %}
# ── {{ cl.module_name }} ──────────────────────────────────────────────────────
variable "{{ cl.module_name }}_name" {
  type    = string
  default = "{{ cl.name }}"
}
variable "{{ cl.module_name }}_display_name" {
  type    = string
  default = "{{ cl.display_name }}"
}
variable "{{ cl.module_name }}_hostname" {
  type    = string
  default = "{{ cl.hostname }}"
}
variable "{{ cl.module_name }}_cpu_core_count" {
  type    = number
  default = {{ cl.cpu_core_count }}
}
variable "{{ cl.module_name }}_data_storage_size_in_tbs" {
  type    = number
  default = {{ cl.data_storage_size_in_tbs }}
}
variable "{{ cl.module_name }}_memory_size_in_gbs" {
  type    = number
  default = {{ cl.memory_size_in_gbs }}
}
variable "{{ cl.module_name }}_db_node_storage_size_in_gbs" {
  type    = number
  default = {{ cl.db_node_storage_size_in_gbs }}
}
variable "{{ cl.module_name }}_gi_version" {
  type    = string
  default = "{{ cl.gi_version }}"
}
variable "{{ cl.module_name }}_license_model" {
  type    = string
  default = "{{ cl.license_model }}"
}
variable "{{ cl.module_name }}_ssh_public_keys" {
  type    = list(string)
  default = {{ cl.ssh_public_keys | tojson }}
}
variable "{{ cl.module_name }}_local_backup_enabled" {
  type    = bool
  default = {{ cl.local_backup_enabled | lower }}
}
variable "{{ cl.module_name }}_sparse_diskgroup_enabled" {
  type    = bool
  default = {{ cl.sparse_diskgroup_enabled | lower }}
}
variable "{{ cl.module_name }}_cluster_name" {
  type    = string
  default = "{{ cl.cluster_name }}"
}
variable "{{ cl.module_name }}_time_zone" {
  type    = string
  default = "{{ cl.time_zone }}"
}
variable "{{ cl.module_name }}_scan_listener_port_tcp" {
  type    = number
  default = {{ cl.scan_listener_port_tcp }}
}
{% endfor %}

{% for adb in adbs %}
# ── {{ adb.module_name }} — Autonomous Database Serverless ────────────────────
variable "{{ adb.module_name }}_name" {
  type    = string
  default = "{{ adb.name }}"
}
variable "{{ adb.module_name }}_display_name" {
  type    = string
  default = "{{ adb.display_name }}"
}
variable "{{ adb.module_name }}_db_workload" {
  type    = string
  default = "{{ adb.db_workload }}"
}
variable "{{ adb.module_name }}_db_version" {
  type    = string
  default = "{{ adb.db_version }}"
}
variable "{{ adb.module_name }}_license_model" {
  type    = string
  default = "{{ adb.license_model }}"
}
variable "{{ adb.module_name }}_compute_model" {
  type    = string
  default = "{{ adb.compute_model }}"
}
variable "{{ adb.module_name }}_compute_count" {
  type    = number
  default = {{ adb.compute_count }}
}
variable "{{ adb.module_name }}_data_storage_size_in_tbs" {
  type    = number
  default = {{ adb.data_storage_size_in_tbs }}
}
variable "{{ adb.module_name }}_auto_scaling_enabled" {
  type    = bool
  default = {{ adb.auto_scaling_enabled | lower }}
}
variable "{{ adb.module_name }}_auto_scaling_for_storage_enabled" {
  type    = bool
  default = {{ adb.auto_scaling_for_storage_enabled | lower }}
}
variable "{{ adb.module_name }}_backup_retention_period_in_days" {
  type    = number
  default = {{ adb.backup_retention_period_in_days }}
}
variable "{{ adb.module_name }}_character_set" {
  type    = string
  default = "{{ adb.character_set }}"
}
variable "{{ adb.module_name }}_national_character_set" {
  type    = string
  default = "{{ adb.national_character_set }}"
}
variable "{{ adb.module_name }}_mtls_connection_required" {
  type    = bool
  default = {{ adb.mtls_connection_required | lower }}
}
variable "{{ adb.module_name }}_allowed_ips" {
  type    = list(string)
  default = {{ adb.allowed_ips | tojson }}
}
variable "{{ adb.module_name }}_customer_contacts" {
  type    = list(string)
  default = {{ adb.customer_contacts | tojson }}
}
# No default — never store a password in a generated file.
#   export TF_VAR_{{ adb.module_name }}_admin_password='...'
variable "{{ adb.module_name }}_admin_password" {
  type      = string
  sensitive = true
}
{% endfor %}
{% for na in network_anchors %}

# ── {{ na.module_name }}: Oracle Network Anchor ───────────────────────────────
variable "{{ na.module_name }}" {
  description = "Network Anchor {{ na.module_name }}. resource_anchor_id / virtual_network_name are read only when this configuration does not build the Resource Anchor / VNet."
  type = object({
    name                            = string
    resource_anchor_id              = optional(string)
    virtual_network_name            = optional(string)
    subnet_name                     = string
    subnet_address_prefix           = string
    zone                            = optional(string)
    oci_vcn_dns_label               = optional(string)
    oci_backup_cidr_block           = optional(string)
    dns_zone_sync_enabled           = optional(bool)
    dns_listening_endpoint_enabled  = optional(bool)
    dns_listening_allowed_cidrs     = optional(list(string), [])
    dns_forwarding_endpoint_enabled = optional(bool)
    dns_forwarding_rules = optional(list(object({
      domain_names          = list(string)
      forwarding_ip_address = string
    })), [])
  })
}
{% endfor %}
