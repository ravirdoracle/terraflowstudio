# terraform.tfvars — Generated by Terraflow Studio
# All module-specific values are consolidated here at the root level.

subscription_id     = "{{ subscription_id }}"
resource_group_name = "{{ resource_group_name }}"
location            = "{{ location }}"
{% if tags %}
tags = {
{% for k, v in tags.items() %}
  "{{ k }}" = "{{ v }}"
{% endfor %}
}
{% endif %}

{% for anc in anchors %}
# ── {{ anc.module_name }} ─────────────────────────────────────────────────────
{{ anc.module_name }}_name = "{{ anc.name }}"
{% endfor %}

{% for net in vnets %}
# ── {{ net.module_name }} ─────────────────────────────────────────────────────
{{ net.module_name }}_vnet_name             = "{{ net.vnet_name }}"
{{ net.module_name }}_address_space         = "{{ net.address_space }}"
{{ net.module_name }}_subnet_name           = "{{ net.subnet_name }}"
{{ net.module_name }}_subnet_address_prefix = "{{ net.subnet_address_prefix }}"
{% endfor %}

{% for inf in infras %}
# ── {{ inf.module_name }} ─────────────────────────────────────────────────────
{% set tw = (inf.module_name | length) + (21 if (inf.database_server_type or inf.storage_server_type) else 14) %}
{{ (inf.module_name ~ "_name").ljust(tw) }} = "{{ inf.name }}"
{{ (inf.module_name ~ "_display_name").ljust(tw) }} = "{{ inf.display_name }}"
{{ (inf.module_name ~ "_shape").ljust(tw) }} = "{{ inf.shape }}"
{% if inf.database_server_type %}
{{ (inf.module_name ~ "_database_server_type").ljust(tw) }} = "{{ inf.database_server_type }}"
{% endif %}
{% if inf.storage_server_type %}
{{ (inf.module_name ~ "_storage_server_type").ljust(tw) }} = "{{ inf.storage_server_type }}"
{% endif %}
{{ (inf.module_name ~ "_compute_count").ljust(tw) }} = {{ inf.compute_count }}
{{ (inf.module_name ~ "_storage_count").ljust(tw) }} = {{ inf.storage_count }}
{{ (inf.module_name ~ "_zone").ljust(tw) }} = "{{ inf.zone }}"
{% endfor %}

{% for cl in clusters %}
# ── {{ cl.module_name }} ──────────────────────────────────────────────────────
{{ cl.module_name }}_name                        = "{{ cl.name }}"
{{ cl.module_name }}_display_name                = "{{ cl.display_name }}"
{{ cl.module_name }}_hostname                    = "{{ cl.hostname }}"
{{ cl.module_name }}_cpu_core_count              = {{ cl.cpu_core_count }}
{{ cl.module_name }}_data_storage_size_in_tbs    = {{ cl.data_storage_size_in_tbs }}
{{ cl.module_name }}_memory_size_in_gbs          = {{ cl.memory_size_in_gbs }}
{{ cl.module_name }}_db_node_storage_size_in_gbs = {{ cl.db_node_storage_size_in_gbs }}
{{ cl.module_name }}_gi_version                  = "{{ cl.gi_version }}"
{{ cl.module_name }}_license_model               = "{{ cl.license_model }}"
{{ cl.module_name }}_ssh_public_keys             = {{ cl.ssh_public_keys | tojson }}
{{ cl.module_name }}_local_backup_enabled        = {{ cl.local_backup_enabled | lower }}
{{ cl.module_name }}_sparse_diskgroup_enabled    = {{ cl.sparse_diskgroup_enabled | lower }}
{{ cl.module_name }}_cluster_name                = "{{ cl.cluster_name }}"
{{ cl.module_name }}_time_zone                   = "{{ cl.time_zone }}"
{{ cl.module_name }}_scan_listener_port_tcp      = {{ cl.scan_listener_port_tcp }}
{% endfor %}

{% for adb in adbs %}
# ── {{ adb.module_name }} — Autonomous Database Serverless ────────────────────
{{ adb.module_name }}_name                             = "{{ adb.name }}"
{{ adb.module_name }}_display_name                     = "{{ adb.display_name }}"
{{ adb.module_name }}_db_workload                      = "{{ adb.db_workload }}"
{{ adb.module_name }}_db_version                       = "{{ adb.db_version }}"
{{ adb.module_name }}_license_model                    = "{{ adb.license_model }}"
{{ adb.module_name }}_compute_model                    = "{{ adb.compute_model }}"
{{ adb.module_name }}_compute_count                    = {{ adb.compute_count }}
{{ adb.module_name }}_data_storage_size_in_tbs         = {{ adb.data_storage_size_in_tbs }}
{{ adb.module_name }}_auto_scaling_enabled             = {{ adb.auto_scaling_enabled | lower }}
{{ adb.module_name }}_auto_scaling_for_storage_enabled = {{ adb.auto_scaling_for_storage_enabled | lower }}
{{ adb.module_name }}_backup_retention_period_in_days  = {{ adb.backup_retention_period_in_days }}
{{ adb.module_name }}_character_set                    = "{{ adb.character_set }}"
{{ adb.module_name }}_national_character_set           = "{{ adb.national_character_set }}"
{{ adb.module_name }}_mtls_connection_required         = {{ adb.mtls_connection_required | lower }}
{{ adb.module_name }}_allowed_ips                      = {{ adb.allowed_ips | tojson }}
{{ adb.module_name }}_customer_contacts                = {{ adb.customer_contacts | tojson }}
# {{ adb.module_name }}_admin_password is set from the environment, not here:
#   export TF_VAR_{{ adb.module_name }}_admin_password='...'
{% endfor %}
{% for entry in network_anchor_entries %}

# ── Oracle Network Anchor ─────────────────────────────────────────────────────
{{ entry }}
{% endfor %}
