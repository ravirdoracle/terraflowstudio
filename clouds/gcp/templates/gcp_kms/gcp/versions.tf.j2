# versions.tf — Generated by Terraflow Studio
# GCP side of the ExaDB-D customer-managed key: Cloud KMS key ring + key, and the
# IAM grant for the VM cluster's Identity Connector. A root of its own, applied
# with Google credentials (Application Default Credentials) and its own state.
terraform {
  required_version = "{{ '>= 1.6.0' if iac_tool == 'opentofu' else '>= 1.5.0' }}"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 7.5.0"
    }
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_kms_location
}
