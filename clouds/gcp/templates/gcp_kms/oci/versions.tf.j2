# versions.tf — Generated by Terraflow Studio
# OCI side of the ExaDB-D customer-managed key: registers the GCP key ring with
# OCI, and optionally adds the policy letting Cloud VM Clusters read it. A root
# of its own - apply it after ../gcp, with OCI credentials and its own state.
terraform {
  required_version = "{{ '>= 1.6.0' if iac_tool == 'opentofu' else '>= 1.5.0' }}"

  required_providers {
    oci = {
      source = "oracle/oci"
      # 7.17.0 is the first release with oci_dbmulticloud_oracle_db_gcp_key_ring.
      version = ">= 7.17.0"
    }
  }
}

# The OCI multicloud region paired with the GCP KMS location.
provider "oci" {
  alias               = "multicloud"
  auth                = var.oci_auth
  config_file_profile = var.oci_config_profile
  region              = var.oci_multicloud_region
}

# IAM policies can only be written in the tenancy's home region, which may
# differ from the multicloud region.
provider "oci" {
  alias               = "home"
  auth                = var.oci_auth
  config_file_profile = var.oci_config_profile
  region              = var.oci_home_region
}
