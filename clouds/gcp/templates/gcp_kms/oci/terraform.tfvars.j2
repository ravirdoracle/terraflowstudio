# terraform.tfvars — Generated by Terraflow Studio
oci_auth              = "{{ k.oci_auth }}"
oci_config_profile    = "{{ k.oci_config_profile }}"
oci_multicloud_region = "{{ k.oci_multicloud_region }}"
oci_home_region       = "{{ k.oci_home_region }}"

oci_compartment_ocid = "{{ k.oci_compartment_ocid }}"
# OCI console > the ExaDB-D VM cluster > Multicloud Information > Identity
# connector > its OCID. Not the compartment's.
oci_gcp_identity_connector_ocid = "{{ k.oci_gcp_identity_connector_ocid }}"

# What ../gcp creates - project, location and name are known, so no hand-off.
gcp_key_ring_id  = "{{ k.gcp_key_ring_id }}"
gcp_kms_location = "{{ k.gcp_kms_location }}"

oci_gcp_key_ring_display_name = "{{ k.oci_gcp_key_ring_display_name }}"
create_cluster_gcp_key_policy = {{ 'true' if k.create_cluster_gcp_key_policy else 'false' }}
oci_gcp_key_policy_name       = "{{ k.oci_gcp_key_policy_name }}"
