{% endif %}
```

Example:
```hcl
odb_networks = {
{% for n in networks %}
  "{{ n.module_name }}" = {
    odb_network_name   = "<resolved-at-apply>"
    client_subnet_name = "<resolved-at-apply>"
{% if n.purpose != 'adbs' %}
    backup_subnet_name = "<resolved-at-apply>"
{% endif %}
  }
{% endfor %}
}
```

