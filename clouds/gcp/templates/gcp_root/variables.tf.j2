# variables.tf — Generated by Terraflow Studio
# Add entries to the map variables below (or in terraform.auto.tfvars) to scale.

variable "gcp_project" {
  description = "Default GCP project ID. Override per-resource via the project field in each map entry."
  type        = string
  default     = "{{ gcp_project }}"
}

variable "gcp_region" {
  description = "Default GCP region. Override per-resource via the location field in each map entry."
  type        = string
  default     = "{{ gcp_region }}"
}
{% if has_std_nets %}

# ── ODB Networks ──────────────────────────────────────────────────────────────
variable "gcp_odb_networks" {
  description = "Map of ODB Networks. Add entries here or in terraform.auto.tfvars to create more networks without any code changes."
  type = map(object({
    odb_network_id      = string
    location            = optional(string, "")
    network             = string
    project             = optional(string, "")
    gcp_oracle_zone     = optional(string, "")
    client_subnet_id    = string
    client_cidr_range   = string
    backup_subnet_id    = string
    backup_cidr_range   = string
    deletion_protection = optional(bool, true)
    labels              = optional(map(string), {})
  }))
  default = {}
}
{% endif %}
{% if adbs_nets %}

# ── ODB Networks — Autonomous AI Database Serverless only ─────────────────────
# No backup subnet: an Autonomous Database never uses one. A VM Cluster does, so
# clusters must reference gcp_odb_networks instead.
variable "gcp_odb_networks_adbs" {
  description = "Map of ADB-S-only ODB Networks — client subnet only, no backup subnet."
  type = map(object({
    odb_network_id      = string
    location            = optional(string, "")
    network             = string
    project             = optional(string, "")
    gcp_oracle_zone     = optional(string, "")
    client_subnet_id    = string
    client_cidr_range   = string
    deletion_protection = optional(bool, true)
    labels              = optional(map(string), {})
  }))
  default = {}
}
{% endif %}
{% if wants_dedicated %}

# ── Exadata Infrastructures ───────────────────────────────────────────────────
variable "gcp_exadata_infras" {
  description = "Map of Exadata Infrastructures. Add entries here or in terraform.auto.tfvars to create more infras without any code changes."
  type = map(object({
    cloud_exadata_infrastructure_id     = string
    location                            = optional(string, "")
    display_name                        = optional(string, "")
    gcp_oracle_zone                     = optional(string, "")
    project                             = optional(string, "")
    shape                               = string
    compute_count                       = number
    storage_count                       = number
    total_storage_size_gb               = optional(number, 0)
    customer_contacts                   = optional(list(string), [])
    mw_preference                       = optional(string, "NO_PREFERENCE")
    mw_patching_mode                    = optional(string, "ROLLING")
    mw_is_custom_action_timeout_enabled = optional(bool, false)
    mw_custom_action_timeout_mins       = optional(number, 15)
    mw_lead_time_week                   = optional(number, null)
    mw_days_of_week                     = optional(list(string), [])
    mw_months                           = optional(list(string), [])
    mw_hours_of_day                     = optional(list(number), [])
    mw_weeks_of_month                   = optional(list(number), [])
    deletion_protection                 = optional(bool, true)
    labels                              = optional(map(string), {})
  }))
  default = {}
}

# ── ExaDB VM Clusters ─────────────────────────────────────────────────────────
variable "gcp_vm_clusters" {
  description = "Map of ExaDB VM Clusters. infra_key and network_key must match keys in gcp_exadata_infras and gcp_odb_networks."
  type = map(object({
    infra_key                = string
    network_key              = string
    cloud_vm_cluster_id      = string
    display_name             = optional(string, "")
    location                 = optional(string, "")
    project                  = optional(string, "")
    hostname_prefix          = string
    cpu_core_count           = number
    memory_size_gb           = number
    db_node_storage_size_gb  = number
    data_storage_size_tb     = number
    gi_version               = optional(string, "23.0.0.0")
    license_type             = optional(string, "LICENSE_INCLUDED")
    ssh_public_keys          = list(string)
    local_backup_enabled     = optional(bool, false)
    sparse_diskgroup_enabled = optional(bool, false)
    cluster_name             = optional(string, null)
    node_count               = optional(number, null)
    ocpu_count               = optional(number, null)
    disk_redundancy          = optional(string, null)
    time_zone                = optional(string, "UTC")
    scan_listener_port_tcp   = optional(number, null)
    dco_diagnostics          = optional(bool, true)
    dco_health               = optional(bool, true)
    dco_incident_logs        = optional(bool, true)
    deletion_protection      = optional(bool, true)
    labels                   = optional(map(string), {})
  }))
  default = {}
}
{% endif %}

{% if adbs %}
# ── Autonomous AI Databases (Serverless) ──────────────────────────────────────
variable "gcp_autonomous_dbs" {
  description = "Map of Autonomous Databases. network_key must match a key in gcp_odb_networks — ADB attaches to that network's client subnet."
  type = map(object({
    network_key                     = string
    autonomous_database_id          = string
    database                        = string
    display_name                    = optional(string, "")
    location                        = optional(string, "")
    project                         = optional(string, "")
    db_workload                     = optional(string, "OLTP")
    license_type                    = optional(string, "LICENSE_INCLUDED")
    db_edition                      = optional(string, "ENTERPRISE_EDITION")
    db_version                      = optional(string, "23ai")
    compute_count                   = optional(number, 2)
    data_storage_size_gb            = optional(number, 120)
    is_auto_scaling_enabled         = optional(bool, true)
    is_storage_auto_scaling_enabled = optional(bool, false)
    backup_retention_period_days    = optional(number, 60)
    maintenance_schedule_type       = optional(string, "REGULAR")
    character_set                   = optional(string, "AL32UTF8")
    n_character_set                 = optional(string, "AL16UTF16")
    operations_insights_state       = optional(string, "NOT_ENABLED")
    mtls_connection_required        = optional(bool, true)
    private_endpoint_label          = optional(string, "")
    private_endpoint_ip             = optional(string, "")
    customer_contacts               = optional(list(string), [])
    deletion_protection             = optional(bool, true)
    labels                          = optional(map(string), {})
  }))
  default = {}
}

# One password per entry in gcp_autonomous_dbs, keyed the same way. Deliberately
# has no default and is never written to a generated file — supply it at apply
# time, e.g.
#
#   export TF_VAR_gcp_adb_admin_passwords='{ {% for a in adbs %}{{ a.module_name }} = "..."{% if not loop.last %}, {% endif %}{% endfor %} }'
#
# 12-30 chars, upper + lower + digit, no double quote, cannot contain "admin".
variable "gcp_adb_admin_passwords" {
  description = "ADMIN passwords for each Autonomous Database, keyed by instance name."
  type        = map(string)
  sensitive   = true
}
{% endif %}
{% if oci_databases %}
# ── OCI provider ──────────────────────────────────────────────────────────────
variable "oci_auth_method" {
  type    = string
  default = "APIKey"
}
variable "oci_region" {
  type    = string
  default = "{{ oci_region }}"
}
variable "oci_tenancy_ocid" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_user_ocid" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_fingerprint" {
  type      = string
  default   = ""
  sensitive = true
}
variable "oci_private_key_path" {
  type    = string
  default = "~/.oci/oci_api_key.pem"
}

{% for db in oci_databases %}
# Set via: export TF_VAR_{{ db.module_name }}_admin_password=...
variable "{{ db.module_name }}_admin_password" {
  type      = string
  sensitive = true
}
{% endfor %}
{% endif %}
{% if exascale %}

# ── Exascale ──────────────────────────────────────────────────────────────────
variable "gcp_exascale_vaults" {
  description = "Map of Exascale Database Storage Vaults."
  type = map(object({
    exascale_db_storage_vault_id   = string
    display_name                   = optional(string, "")
    location                       = optional(string, "")
    project                        = optional(string, "")
    gcp_oracle_zone                = optional(string, "")
    total_size_gbs                 = number
    additional_flash_cache_percent = optional(number)
    time_zone                      = optional(string)
    deletion_protection            = optional(bool, true)
    labels                         = optional(map(string), {})
  }))
  default = {}
}

variable "gcp_exascale_vm_clusters" {
  description = "Map of Exascale VM Clusters. network_key must match a key in gcp_odb_networks; vault_key one in gcp_exascale_vaults, or set existing_vault instead."
  type = map(object({
    network_key                      = string
    vault_key                        = optional(string, "")
    existing_vault                   = optional(string, "")
    exadb_vm_cluster_id              = string
    display_name                     = optional(string, "")
    location                         = optional(string, "")
    project                          = optional(string, "")
    grid_image_id                    = string
    shape_attribute                  = optional(string, "SMART_STORAGE")
    node_count                       = number
    enabled_ecpu_count_per_node      = number
    additional_ecpu_count_per_node   = optional(number)
    vm_file_system_size_gbs_per_node = number
    hostname_prefix                  = string
    cluster_name                     = optional(string)
    license_model                    = optional(string, "LICENSE_INCLUDED")
    ssh_public_keys                  = list(string)
    scan_listener_port_tcp           = optional(number)
    time_zone                        = optional(string)
    dco_diagnostics                  = optional(bool, true)
    dco_health                       = optional(bool, true)
    dco_incident_logs                = optional(bool, true)
    deletion_protection              = optional(bool, true)
    labels                           = optional(map(string), {})
  }))
  default = {}

  validation {
    condition     = alltrue([for c in values(var.gcp_exascale_vm_clusters) : (c.vault_key != "") != (c.existing_vault != "")])
    error_message = "Each Exascale VM Cluster takes exactly one of vault_key or existing_vault."
  }
}
{% endif %}
