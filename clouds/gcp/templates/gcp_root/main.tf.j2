# main.tf — Generated by Terraflow Studio
{% if exascale and not wants_dedicated %}
# AI DB@GCP: ODB Networks → Exascale Storage Vaults → Exascale VM Clusters{% if adbs %} · Autonomous DBs{% endif +%}
#
# Exascale only: no Exadata Infrastructure to provision. The ODB Networks keep
# their backup subnet, which an Exascale VM Cluster needs.
#
{% elif wants_dedicated %}
# AI DB@GCP: ODB Networks → Exadata Infras → ExaDB VM Clusters{% if adbs %} · Autonomous DBs{% endif +%}
{% else %}
# AI DB@GCP: ODB Networks → Autonomous AI Databases (Serverless)
#
# Serverless only: Oracle runs the fleet, so this configuration has no Exadata
# Infrastructure and no VM Cluster, and its ODB Networks have no backup subnet.
#
{% endif %}
# Toolchain: {{ 'OpenTofu' if iac_tool == 'opentofu' else 'Terraform' }}
#
{% if exascale and not wants_dedicated %}
# Scale without re-generating: add entries to var.gcp_odb_networks,
# var.gcp_exascale_vaults or var.gcp_exascale_vm_clusters in terraform.auto.tfvars.
{% elif wants_dedicated %}
# Scale without re-generating: add entries to var.gcp_odb_networks,
# var.gcp_exadata_infras,{% if adbs %} var.gcp_autonomous_dbs,{% endif %} or var.gcp_vm_clusters in terraform.auto.tfvars.
{% else %}
# Scale without re-generating: add entries to var.gcp_odb_networks_adbs or
# var.gcp_autonomous_dbs in terraform.auto.tfvars.
{% endif %}

terraform {
  required_version = "{{ '>= 1.6.0' if iac_tool == 'opentofu' else '>= 1.5.0' }}"
  required_providers {
    google = {
{% if iac_tool == 'opentofu' %}
      # OpenTofu resolves hashicorp/google from registry.opentofu.org by default
{% endif %}
      # The oldest release these modules validate against, found by bisecting
      # published releases (it also carries odb_network / odb_subnet on
      # google_oracle_database_autonomous_database, which arrived in 7.0).
{% if exascale %}
      # Exascale moves it to the first release with those resources.
{% endif %}
      source  = "hashicorp/google"
      version = "{{ '>= ' ~ exascale_floor if exascale else '>= 7.5.0' }}"
    }
{% if oci_databases %}
    oci = {
      source  = "oracle/oci"
      version = ">= 6.0.0"
    }
{% endif %}
  }
}

provider "google" {
  project = var.gcp_project
  region  = var.gcp_region
}

{% if oci_databases %}
# ── OCI Provider (DB Home / CDB / PDB) ───────────────────────────────────────
provider "oci" {
  auth             = var.oci_auth_method
  region           = var.oci_region
  tenancy_ocid     = var.oci_auth_method == "APIKey" ? var.oci_tenancy_ocid     : null
  user_ocid        = var.oci_auth_method == "APIKey" ? var.oci_user_ocid        : null
  fingerprint      = var.oci_auth_method == "APIKey" ? var.oci_fingerprint      : null
  private_key_path = var.oci_auth_method == "APIKey" ? var.oci_private_key_path : null
}
{% endif %}
{% if has_std_nets %}

# ── ODB Networks ──────────────────────────────────────────────────────────────
# To add another network: append an entry to gcp_odb_networks in terraform.auto.tfvars.
module "gcp_odb_network" {
  source   = "./modules/gcp-odb-network"
  for_each = var.gcp_odb_networks

  odb_network_id      = each.value.odb_network_id
  location            = each.value.location != "" ? each.value.location : var.gcp_region
  network             = each.value.network
  project             = each.value.project != "" ? each.value.project : var.gcp_project
  gcp_oracle_zone     = each.value.gcp_oracle_zone
  client_subnet_id    = each.value.client_subnet_id
  client_cidr_range   = each.value.client_cidr_range
  backup_subnet_id    = each.value.backup_subnet_id
  backup_cidr_range   = each.value.backup_cidr_range
  deletion_protection = each.value.deletion_protection
  labels              = each.value.labels
}
{% endif %}
{% if adbs_nets %}
{% if has_std_nets %}

{% endif %}
# ── ODB Networks — Autonomous AI Database Serverless only ─────────────────────
# Flagged "adbs" on the card, so these are built from a module that creates no
# backup subnet: an Autonomous Database never uses one. A VM Cluster cannot
# reference these networks — it needs a backup subnet.
module "gcp_odb_network_adbs" {
  source   = "./modules/gcp-odb-network-adbs"
  for_each = var.gcp_odb_networks_adbs

  odb_network_id      = each.value.odb_network_id
  location            = each.value.location != "" ? each.value.location : var.gcp_region
  network             = each.value.network
  project             = each.value.project != "" ? each.value.project : var.gcp_project
  gcp_oracle_zone     = each.value.gcp_oracle_zone
  client_subnet_id    = each.value.client_subnet_id
  client_cidr_range   = each.value.client_cidr_range
  deletion_protection = each.value.deletion_protection
  labels              = each.value.labels
}

# Both network kinds expose the same two values an Autonomous Database needs, so
# an ADB can reference either without caring which module built it.
locals {
  adb_odb_networks = merge(
{% if dedicated_nets %}
    { for k, v in module.gcp_odb_network : k => {
      odb_network_name   = v.odb_network_name
      client_subnet_name = v.client_subnet_name
    } },
{% endif %}
    { for k, v in module.gcp_odb_network_adbs : k => {
      odb_network_name   = v.odb_network_name
      client_subnet_name = v.client_subnet_name
    } },
  )
}
{% endif %}
{% if wants_dedicated %}

# ── Exadata Infrastructures ───────────────────────────────────────────────────
# To add another infra: append an entry to gcp_exadata_infras in terraform.auto.tfvars.
module "gcp_exadata_infra" {
  source   = "./modules/gcp-exadata-infra"
  for_each = var.gcp_exadata_infras

  cloud_exadata_infrastructure_id     = each.value.cloud_exadata_infrastructure_id
  location                            = each.value.location != "" ? each.value.location : var.gcp_region
  display_name                        = each.value.display_name
  gcp_oracle_zone                     = each.value.gcp_oracle_zone
  project                             = each.value.project != "" ? each.value.project : var.gcp_project
  shape                               = each.value.shape
  compute_count                       = each.value.compute_count
  storage_count                       = each.value.storage_count
  total_storage_size_gb               = each.value.total_storage_size_gb
  customer_contacts                   = each.value.customer_contacts
  mw_preference                       = each.value.mw_preference
  mw_patching_mode                    = each.value.mw_patching_mode
  mw_is_custom_action_timeout_enabled = each.value.mw_is_custom_action_timeout_enabled
  mw_custom_action_timeout_mins       = each.value.mw_custom_action_timeout_mins
  mw_lead_time_week                   = each.value.mw_lead_time_week
  mw_days_of_week                     = each.value.mw_days_of_week
  mw_months                           = each.value.mw_months
  mw_hours_of_day                     = each.value.mw_hours_of_day
  mw_weeks_of_month                   = each.value.mw_weeks_of_month
  deletion_protection                 = each.value.deletion_protection
  labels                              = each.value.labels
}

# ── DB Server OCIDs ───────────────────────────────────────────────────────────
# Auto-discovered per cluster from the Exadata Infrastructure.
data "google_oracle_database_db_servers" "this" {
  depends_on                   = [module.gcp_exadata_infra]
  for_each                     = var.gcp_vm_clusters
  location                     = each.value.location != "" ? each.value.location : var.gcp_region
  project                      = each.value.project != "" ? each.value.project : var.gcp_project
  cloud_exadata_infrastructure = module.gcp_exadata_infra[each.value.infra_key].infra_self_link
}

# ── ExaDB VM Clusters ─────────────────────────────────────────────────────────
# To add another cluster: append an entry to gcp_vm_clusters in terraform.auto.tfvars.
module "gcp_vm_cluster" {
  source   = "./modules/gcp-vm-cluster"
  for_each = var.gcp_vm_clusters

  cloud_vm_cluster_id      = each.value.cloud_vm_cluster_id
  display_name             = each.value.display_name
  location                 = each.value.location != "" ? each.value.location : var.gcp_region
  project                  = each.value.project != "" ? each.value.project : var.gcp_project
  exadata_infrastructure   = module.gcp_exadata_infra[each.value.infra_key].infra_self_link
  odb_network              = module.gcp_odb_network[each.value.network_key].odb_network_name
  odb_subnet               = module.gcp_odb_network[each.value.network_key].client_subnet_name
  backup_odb_subnet        = module.gcp_odb_network[each.value.network_key].backup_subnet_name
  db_server_ocids          = data.google_oracle_database_db_servers.this[each.key].db_servers[*].properties.0.ocid
  hostname_prefix          = each.value.hostname_prefix
  cpu_core_count           = each.value.cpu_core_count
  memory_size_gb           = each.value.memory_size_gb
  db_node_storage_size_gb  = each.value.db_node_storage_size_gb
  data_storage_size_tb     = each.value.data_storage_size_tb
  gi_version               = each.value.gi_version
  license_type             = each.value.license_type
  ssh_public_keys          = each.value.ssh_public_keys
  local_backup_enabled     = each.value.local_backup_enabled
  sparse_diskgroup_enabled = each.value.sparse_diskgroup_enabled
  cluster_name             = each.value.cluster_name
  node_count               = each.value.node_count
  ocpu_count               = each.value.ocpu_count
  disk_redundancy          = each.value.disk_redundancy
  time_zone                = each.value.time_zone
  scan_listener_port_tcp   = each.value.scan_listener_port_tcp
  dco_diagnostics          = each.value.dco_diagnostics
  dco_health               = each.value.dco_health
  dco_incident_logs        = each.value.dco_incident_logs
  deletion_protection      = each.value.deletion_protection
  labels                   = each.value.labels

  depends_on = [
    module.gcp_odb_network,
    module.gcp_exadata_infra,
  ]
}
{% endif %}
{% if exascale %}

# ── Exascale Database Storage Vaults ──────────────────────────────────────────
# To add another vault: append an entry to gcp_exascale_vaults in terraform.auto.tfvars.
module "gcp_exascale_vault" {
  source   = "./modules/gcp-exascale-vault"
  for_each = var.gcp_exascale_vaults

  exascale_db_storage_vault_id   = each.value.exascale_db_storage_vault_id
  display_name                   = each.value.display_name
  location                       = each.value.location != "" ? each.value.location : var.gcp_region
  project                        = each.value.project != "" ? each.value.project : var.gcp_project
  gcp_oracle_zone                = each.value.gcp_oracle_zone
  total_size_gbs                 = each.value.total_size_gbs
  additional_flash_cache_percent = each.value.additional_flash_cache_percent
  time_zone                      = each.value.time_zone
  deletion_protection            = each.value.deletion_protection
  labels                         = each.value.labels
}

# ── Exascale VM Clusters ──────────────────────────────────────────────────────
# No Exadata Infrastructure: the cluster runs on Oracle-managed Exascale
# infrastructure, in its vault's zone. It needs the client AND backup subnet.
# To add another cluster: append an entry to gcp_exascale_vm_clusters.
module "gcp_exascale_vm_cluster" {
  source   = "./modules/gcp-exascale-vm-cluster"
  for_each = var.gcp_exascale_vm_clusters

  exadb_vm_cluster_id = each.value.exadb_vm_cluster_id
  display_name        = each.value.display_name
  location            = each.value.location != "" ? each.value.location : var.gcp_region
  project             = each.value.project != "" ? each.value.project : var.gcp_project
  odb_network         = module.gcp_odb_network[each.value.network_key].odb_network_name
  odb_subnet          = module.gcp_odb_network[each.value.network_key].client_subnet_name
  backup_odb_subnet   = module.gcp_odb_network[each.value.network_key].backup_subnet_name

  # A vault from this configuration, or one built elsewhere by full name.
  exascale_db_storage_vault = each.value.vault_key != "" ? module.gcp_exascale_vault[each.value.vault_key].vault_id : each.value.existing_vault

  grid_image_id                    = each.value.grid_image_id
  shape_attribute                  = each.value.shape_attribute
  node_count                       = each.value.node_count
  enabled_ecpu_count_per_node      = each.value.enabled_ecpu_count_per_node
  additional_ecpu_count_per_node   = each.value.additional_ecpu_count_per_node
  vm_file_system_size_gbs_per_node = each.value.vm_file_system_size_gbs_per_node
  hostname_prefix                  = each.value.hostname_prefix
  cluster_name                     = each.value.cluster_name
  license_model                    = each.value.license_model
  ssh_public_keys                  = each.value.ssh_public_keys
  scan_listener_port_tcp           = each.value.scan_listener_port_tcp
  time_zone                        = each.value.time_zone
  dco_diagnostics                  = each.value.dco_diagnostics
  dco_health                       = each.value.dco_health
  dco_incident_logs                = each.value.dco_incident_logs
  deletion_protection              = each.value.deletion_protection
  labels                           = each.value.labels

  depends_on = [
    module.gcp_odb_network,
    module.gcp_exascale_vault,
  ]
}
{% endif %}

{% if adbs %}
# ── Autonomous AI Databases (Serverless) ──────────────────────────────────────
# To add another database: append an entry to gcp_autonomous_dbs in
# terraform.auto.tfvars, and add its admin password to gcp_adb_admin_passwords.
#
# Serverless runs on Oracle's fleet, so these depend on the ODB Network only —
# no Exadata Infrastructure, no VM Cluster, and no backup subnet.
module "gcp_autonomous_db" {
  source   = "./modules/gcp-autonomous-db"
  for_each = var.gcp_autonomous_dbs

  autonomous_database_id = each.value.autonomous_database_id
  location               = each.value.location != "" ? each.value.location : var.gcp_region
  project                = each.value.project != "" ? each.value.project : var.gcp_project
  database               = each.value.database
  display_name           = each.value.display_name

  admin_password = var.gcp_adb_admin_passwords[each.key]

{% if adbs_nets %}
  odb_network = local.adb_odb_networks[each.value.network_key].odb_network_name
  odb_subnet  = local.adb_odb_networks[each.value.network_key].client_subnet_name
{% else %}
  odb_network = module.gcp_odb_network[each.value.network_key].odb_network_name
  odb_subnet  = module.gcp_odb_network[each.value.network_key].client_subnet_name
{% endif %}

  db_workload  = each.value.db_workload
  license_type = each.value.license_type
  db_edition   = each.value.db_edition
  db_version   = each.value.db_version

  compute_count                   = each.value.compute_count
  data_storage_size_gb            = each.value.data_storage_size_gb
  is_auto_scaling_enabled         = each.value.is_auto_scaling_enabled
  is_storage_auto_scaling_enabled = each.value.is_storage_auto_scaling_enabled

  backup_retention_period_days = each.value.backup_retention_period_days
  maintenance_schedule_type    = each.value.maintenance_schedule_type

  character_set             = each.value.character_set
  n_character_set           = each.value.n_character_set
  operations_insights_state = each.value.operations_insights_state

  mtls_connection_required = each.value.mtls_connection_required
  private_endpoint_label   = each.value.private_endpoint_label
  private_endpoint_ip      = each.value.private_endpoint_ip
  customer_contacts        = each.value.customer_contacts

  deletion_protection = each.value.deletion_protection
  labels              = each.value.labels

{% if adbs_nets and dedicated_nets %}
  depends_on = [module.gcp_odb_network, module.gcp_odb_network_adbs]
{% elif adbs_nets %}
  depends_on = [module.gcp_odb_network_adbs]
{% else %}
  depends_on = [module.gcp_odb_network]
{% endif %}
}

{% endif %}
{% for db in oci_databases %}
# ── OCI DB: {{ db.module_name }} — Step 1: DB Home ───────────────────────────
module "{{ db.module_name }}_dbhome" {
  source          = "./modules/{{ db.module_name }}_dbhome"
  vm_cluster_ocid = module.gcp_vm_cluster["{{ db.vmcluster_ref }}"].ocid
  depends_on      = [module.gcp_vm_cluster]
}

# ── OCI DB: {{ db.module_name }} — Step 2: CDB ───────────────────────────────
module "{{ db.module_name }}_cdb" {
  source         = "./modules/{{ db.module_name }}_cdb"
  db_home_id     = module.{{ db.module_name }}_dbhome.db_home_id
  admin_password = var.{{ db.module_name }}_admin_password
  depends_on     = [module.{{ db.module_name }}_dbhome]
}

{% if db.create_pdb and db.pdb_name %}
# ── OCI DB: {{ db.module_name }} — Step 3: PDB ───────────────────────────────
module "{{ db.module_name }}_pdb" {
  source                = "./modules/{{ db.module_name }}_pdb"
  container_database_id = module.{{ db.module_name }}_cdb.cdb_id
  pdb_admin_password    = var.{{ db.module_name }}_admin_password
  depends_on            = [module.{{ db.module_name }}_cdb]
}
{% endif %}

output "{{ db.module_name }}_db_home_id" { value = module.{{ db.module_name }}_dbhome.db_home_id }
output "{{ db.module_name }}_cdb_id"     { value = module.{{ db.module_name }}_cdb.cdb_id }
{% if db.create_pdb and db.pdb_name %}
output "{{ db.module_name }}_pdb_id" { value = module.{{ db.module_name }}_pdb.pdb_id }
{% endif %}

{% endfor %}
# ── Outputs ────────────────────────────────────────────────────────────────────
{% if has_std_nets %}
output "odb_networks" {
  description = "ODB Network details keyed by instance name."
  value = { for k, v in module.gcp_odb_network : k => {
    odb_network_name   = v.odb_network_name
    client_subnet_name = v.client_subnet_name
    backup_subnet_name = v.backup_subnet_name
  } }
}
{% endif %}
{% if adbs_nets %}

output "odb_networks_adbs" {
  description = "ADB-S-only ODB Network details keyed by instance name. No backup subnet by design."
  value = { for k, v in module.gcp_odb_network_adbs : k => {
    odb_network_name   = v.odb_network_name
    client_subnet_name = v.client_subnet_name
  } }
}
{% endif %}
{% if wants_dedicated %}

output "exadata_infras" {
  description = "Exadata Infrastructure details keyed by instance name."
  value = { for k, v in module.gcp_exadata_infra : k => {
    infra_name = v.infra_name
    ocid       = v.ocid
  } }
}

output "vm_clusters" {
  description = "VM Cluster details keyed by instance name."
  value = { for k, v in module.gcp_vm_cluster : k => {
    vm_cluster_name = v.vm_cluster_name
    ocid            = v.ocid
  } }
}

output "db_servers" {
  description = "DB Server OCIDs per cluster, keyed by cluster instance name."
  value       = { for k, v in data.google_oracle_database_db_servers.this : k => v.db_servers[*].properties.0.ocid }
}
{% endif %}
{% if adbs %}

output "autonomous_databases" {
  description = "Autonomous Database details keyed by instance name."
  value = { for k, v in module.gcp_autonomous_db : k => {
    autonomous_database_name = v.autonomous_database_name
    ocid                     = v.ocid
  } }
}
{% endif %}
{% if exascale %}

output "exascale_vaults" {
  description = "Exascale Database Storage Vaults keyed by instance name."
  value = { for k, v in module.gcp_exascale_vault : k => {
    vault_id = v.vault_id
    ocid     = v.ocid
  } }
}

output "exascale_vm_clusters" {
  description = "Exascale VM Clusters keyed by instance name."
  value = { for k, v in module.gcp_exascale_vm_cluster : k => {
    vm_cluster_name = v.vm_cluster_name
    gcp_oracle_zone = v.gcp_oracle_zone
  } }
}
{% endif %}
