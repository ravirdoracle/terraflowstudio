variable "config" {
  type = object({
{{ fields }}
  })
  validation {
    condition = (
      contains(["create", "existing"], var.config.vpc_mode) &&
      contains(["create", "existing"], var.config.attachment_mode) &&
      contains(["create", "existing"], var.config.peering_mode) &&
      (var.config.vpc_mode == "existing" || (var.config.attachment_mode == "create" && var.config.peering_mode == "create"))
    )
    error_message = "Choose create/existing modes consistently: a new VPC needs a new attachment and peering."
  }
  validation {
    condition = (
      length(var.config.odb_cidrs) > 0 && length(var.config.client_cidrs) > 0 &&
      alltrue([for cidr in concat(var.config.odb_cidrs, var.config.client_cidrs) : can(cidrnetmask(cidr))])
    )
    error_message = "ODB and application CIDRs must be nonempty lists of valid IPv4 CIDRs."
  }
}
variable "odb_network_id" {
  type = string
}
variable "name" {
  type = string
}
variable "region" {
  type = string
}
variable "tags" {
  type    = map(string)
  default = {}
}
