variable "name" {
  description = "Name of the resource share."
  type        = string
}

variable "principals" {
  description = "AWS account IDs to share with. They must be in the same AWS Organization."
  type        = list(string)
}

variable "resource_arns" {
  description = "Resources to share, keyed by a stable name — ODB Network and Exadata Infrastructure ARNs."
  type        = map(string)
}

variable "allow_external_principals" {
  description = "Allow accounts outside the Organization. Oracle AI Database@AWS sharing is Organization-only, so leave false."
  type        = bool
  default     = false
}

variable "tags" {
  description = "Tags to assign to the resource share."
  type        = map(string)
  default     = { "ManagedBy" = "Terraform" }
}
