    network_ref                           = string
    autonomous_data_storage_size_in_tbs   = optional(number, 5)
    cpu_core_count_per_node               = optional(number, 40)
    memory_per_oracle_compute_unit_in_gbs = optional(number, 2)
    total_container_databases             = optional(number, 2)
    scan_listener_port_non_tls            = optional(number, 1521)
    scan_listener_port_tls                = optional(number, 2484)
    license_model                         = optional(string, "LICENSE_INCLUDED")
    is_mtls_enabled_vm_cluster            = optional(bool, false)
    db_servers                            = optional(list(string), [])
    db_servers_mode                       = optional(string, "auto")
    description                           = optional(string, "")
    time_zone                             = optional(string, "")
    mw_preference                         = optional(string, "NO_PREFERENCE")
    mw_lead_time_in_weeks                 = optional(number, 0)
    mw_days_of_week                       = optional(list(string), [])
    mw_months                             = optional(list(string), [])
    mw_hours_of_day                       = optional(list(number), [])
    mw_weeks_of_month                     = optional(list(number), [])
  }))
  default = {}

  validation {
    condition = alltrue([
      for k, c in var.aws_avmclusters : contains(["auto", "unallocated", "manual"], c.db_servers_mode)
    ])
    error_message = "db_servers_mode must be \"auto\" (every DB server on the infrastructure), \"unallocated\" (only servers no cluster holds yet) or \"manual\" (the db_servers list you supply)."
  }
}

{% endif %}
{% if avmclusters_arn %}
# ── Autonomous VM Clusters referencing infra/network by ARN ───────────────────
# Same shape as aws_avmclusters, but the infra and network are named by ARN
# because they live in another account or stack. The provider rejects a config
# carrying both pairs, so these are a separate map served by a separate module.
variable "aws_avmclusters_arn" {
  description = "Map of Autonomous VM Clusters whose Exadata Infrastructure and ODB Network are referenced by ARN."
  type = map(object({
    display_name                          = string
    cloud_exadata_infrastructure_arn      = string
    odb_network_arn                       = string
    autonomous_data_storage_size_in_tbs   = optional(number, 5)
    cpu_core_count_per_node               = optional(number, 40)
    memory_per_oracle_compute_unit_in_gbs = optional(number, 2)
    total_container_databases             = optional(number, 2)
    scan_listener_port_non_tls            = optional(number, 1521)
    scan_listener_port_tls                = optional(number, 2484)
    license_model                         = optional(string, "LICENSE_INCLUDED")
    is_mtls_enabled_vm_cluster            = optional(bool, false)
    db_servers                            = optional(list(string), [])
    db_servers_mode                       = optional(string, "manual")
    description                           = optional(string, "")
    time_zone                             = optional(string, "")
    mw_preference                         = optional(string, "NO_PREFERENCE")
    mw_lead_time_in_weeks                 = optional(number, 0)
    mw_days_of_week                       = optional(list(string), [])
    mw_months                             = optional(list(string), [])
    mw_hours_of_day                       = optional(list(number), [])
    mw_weeks_of_month                     = optional(list(number), [])
  }))
  default = {}
}

{% endif %}
{% if adbs %}
# ── Autonomous Databases (Serverless) ─────────────────────────────────────────
# Optional + Computed arguments default to null, which leaves the value to the
# service and produces no diff. Set one only to override what the service picks.
variable "aws_autonomous_dbs" {
  description = "Map of Autonomous Databases (Serverless). network_ref must match a key in aws_networks."
  type = map(object({
    display_name             = string
    db_name                  = string
    network_ref              = string
    db_workload              = optional(string, "OLTP")
    license_model            = optional(string, "LICENSE_INCLUDED")
    compute_count            = optional(number, 2)
    data_storage_size_in_tbs = optional(number, 1)

    database_edition                     = optional(string)
    db_version                           = optional(string)
    is_auto_scaling_enabled              = optional(bool)
    is_auto_scaling_for_storage_enabled  = optional(bool)
    backup_retention_period_in_days      = optional(number)
    autonomous_maintenance_schedule_type = optional(string)
    is_mtls_connection_required          = optional(bool)
    private_endpoint_label               = optional(string)
    private_endpoint_ip                  = optional(string)
    allowlisted_ips                      = optional(list(string), [])
    character_set                        = optional(string)
    ncharacter_set                       = optional(string)
    encryption_key_provider              = optional(string)
    kms_key_id                           = optional(string)
    customer_contacts                    = optional(list(string), [])

    admin_password_source     = optional(string, "write_only")
    admin_password_wo_version = optional(number, 1)
    secret_arn                = optional(string)
    secret_iam_role_arn       = optional(string)
    secret_external_id_type   = optional(string, "compartment_ocid")
  }))
  default = {}

  # Read by this configuration, not the provider, so a typo would otherwise
  # silently pick neither password source.
  validation {
    condition = alltrue([
      for k, a in var.aws_autonomous_dbs : contains(["write_only", "secrets_manager"], a.admin_password_source)
    ])
    error_message = "admin_password_source must be \"write_only\" (password from TF_VAR_aws_adb_admin_passwords) or \"secrets_manager\" (AWS Secrets Manager)."
  }

  validation {
    condition = alltrue([
      for k, a in var.aws_autonomous_dbs : a.admin_password_source != "secrets_manager" || (
        a.secret_arn != null && a.secret_iam_role_arn != null
      )
    ])
    error_message = "admin_password_source = \"secrets_manager\" needs secret_arn and secret_iam_role_arn."
  }
}

# ADMIN password for Autonomous Databases using admin_password_source =
# "write_only". Never written to a file, a plan or state: ephemeral, and passed
# only to the write-only admin_password_wo argument. 12-30 characters.
#
# One password for every such database — the value is just the password:
#   macOS / Linux:  export TF_VAR_aws_adb_admin_password='...'
#   PowerShell:     $env:TF_VAR_aws_adb_admin_password = '...'
variable "aws_adb_admin_password" {
  description = "ADMIN password applied to every write_only Autonomous Database without its own entry in aws_adb_admin_passwords."
  type        = string
  default     = null
  sensitive   = true
  ephemeral   = true
}

# Optional: a different password per database, keyed by its aws_autonomous_dbs key.
# Here the value is an HCL map, so the inner double quotes are required.
variable "aws_adb_admin_passwords" {
  description = "ADMIN passwords (12-30 characters) for Autonomous Databases using admin_password_source = \"write_only\"."
  type        = map(string)
  default     = {}
  sensitive   = true
  ephemeral   = true
}

{% endif %}
{% if ram_shares %}
# ── AWS RAM resource shares ───────────────────────────────────────────────────
variable "aws_ram_shares" {
  description = "AWS RAM resource shares. network_refs / infra_refs are keys of aws_networks / aws_infras (or of the existing_* ARN maps); principals are AWS account IDs in the same Organization."
  type = map(object({
    name                      = string
    principals                = list(string)
    network_refs              = optional(list(string), [])
    infra_refs                = optional(list(string), [])
    resource_arns             = optional(list(string), [])
    allow_external_principals = optional(bool, false)
  }))
  default = {}

  validation {
    condition = alltrue(flatten([
      for k, s in var.aws_ram_shares : [for p in s.principals : can(regex("^[0-9]{12}$", p))]
    ]))
    error_message = "Every RAM share principal must be a 12-digit AWS account ID."
  }

  validation {
    condition = alltrue([
      for k, s in var.aws_ram_shares : length(s.network_refs) + length(s.infra_refs) + length(s.resource_arns) > 0
    ])
    error_message = "Every RAM share needs at least one resource: a network_ref, an infra_ref or a resource ARN."
  }
}

# ARNs of externally provisioned networks / infras, so a share can name them by
# the same key the clusters use.
variable "existing_odb_network_arns" {
  description = "ARNs of ODB Networks provisioned outside this configuration, keyed by network_ref."
  type        = map(string)
  default     = {}
}

variable "existing_infra_arns" {
  description = "ARNs of Exadata Infrastructures provisioned outside this configuration, keyed by infra_ref."
  type        = map(string)
  default     = {}
}

{% endif %}

{% if kms_keys %}
# ── TDE master keys in AWS KMS ────────────────────────────────────────────────
variable "aws_kms_keys" {
  description = "TDE keys keyed by name. cluster_refs are keys of aws_clusters; each cluster takes one key. existing_arn adopts a key instead of creating one."
  type = map(object({
    cluster_refs            = list(string)
    alias                   = optional(string, "")
    existing_arn            = optional(string, "")
    deletion_window_in_days = optional(number, 30)
    multi_region            = optional(bool, false)
    enable_key_rotation     = optional(bool, false)
    oci_compartment_id      = optional(string, "") # defaults to the register_via cluster's
    register_via            = optional(string, "") # defaults to the first cluster_ref
  }))
  default = {}

  validation {
    condition     = alltrue([for k, v in var.aws_kms_keys : length(v.cluster_refs) > 0])
    error_message = "Every TDE key needs at least one cluster_ref — the key is registered in OCI through a cluster's identity connector."
  }

  validation {
    condition = length(flatten([for k, v in var.aws_kms_keys : v.cluster_refs])) == length(distinct(flatten([
      for k, v in var.aws_kms_keys : v.cluster_refs
    ])))
    error_message = "A VM cluster can take only one TDE key: a cluster_ref appears under two keys."
  }
}

# Exactly one of the two: reuse the account's OIDC provider for the OCI identity
# domain (Oracle's CloudFormation stack creates one), or create it.
variable "aws_kms_oidc_provider_arn" {
  description = "ARN of the existing IAM OIDC provider for the OCI identity domain."
  type        = string
  default     = ""
}

variable "aws_kms_oidc_provider_url" {
  description = "OCI identity domain URL, to create the OIDC provider — https://idcs-<id>.identity.oraclecloud.com, no trailing slash."
  type        = string
  default     = ""
}

variable "aws_kms_oidc_audience" {
  description = "aud claim of the identity domain's tokens. Set: required by every role, and a reused provider must list it. Oracle does not publish it — read it from the provider's Audiences in IAM."
  type        = string
  default     = ""
}

variable "aws_kms_isolate_role_to_cluster" {
  description = "Pin each role's trust policy to its own cluster (the rpst_id claim = the cluster OCID)."
  type        = bool
  default     = true
}

variable "aws_kms_oci_policy_compartment_id" {
  description = "Compartment (or tenancy) OCID to create the OCI policy that lets the clusters read their keys in. Empty: not created."
  type        = string
  default     = ""
}

{% endif %}
