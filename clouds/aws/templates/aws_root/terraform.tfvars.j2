# terraform.auto.tfvars — Generated by Terraflow Studio
# To add resources without re-running the generator, append new map entries below.

aws_region = "{{ aws_region }}"

tags = {
{% for k, v in tags.items() %}
  "{{ k }}" = "{{ v }}"
{% else %}
  "ManagedBy" = "Terraform"
{% endfor %}
}

{% if external_networks %}
# Provisioned outside Terraform — referenced by ID, never created or destroyed.
existing_odb_network_ids = {
{% for net in external_networks %}
  "{{ net.module_name }}" = "{{ net.existing_id }}"
{% endfor %}
}

{% endif %}
{% if external_infras %}
# Provisioned outside Terraform — referenced by ID, never created or destroyed.
existing_infra_ids = {
{% for inf in external_infras %}
  "{{ inf.module_name }}" = "{{ inf.existing_id }}"
{% endfor %}
}

{% endif %}
{% if not networks %}
aws_networks = {}
{% else %}
aws_networks = {
{% for net in networks %}
  "{{ net.module_name }}" = {
    display_name                = "{{ net.display_name }}"
    availability_zone_id        = "{{ net.availability_zone_id }}"
    client_subnet_cidr          = "{{ net.client_subnet_cidr }}"
    backup_subnet_cidr          = "{{ net.backup_subnet_cidr }}"
    s3_access                   = "{{ net.s3_access }}"
    zero_etl_access             = "{{ net.zero_etl_access }}"
{% if net.region %}
    region                      = "{{ net.region }}"
{% endif %}
{% if net.availability_zone %}
    availability_zone           = "{{ net.availability_zone }}"
{% endif %}
{% if net.custom_domain_name %}
    custom_domain_name          = "{{ net.custom_domain_name }}"
{% elif net.default_dns_prefix %}
    default_dns_prefix          = "{{ net.default_dns_prefix }}"
{% endif %}
    delete_associated_resources = {{ net.delete_associated_resources | lower }}
{% if net.sts_access or net.kms_access or net.s3_policy_document or net.sts_policy_document or net.kms_policy_document %}

{% if net.sts_access %}
    {{ "sts_access".ljust(net.opt_pad) }} = "{{ net.sts_access }}"
{% endif %}
{% if net.kms_access %}
    {{ "kms_access".ljust(net.opt_pad) }} = "{{ net.kms_access }}"
{% endif %}
{% if net.s3_policy_document %}
    {{ "s3_policy_document".ljust(net.opt_pad) }} = <<-EOT
{{ net.s3_policy_document }}
EOT
{% endif %}
{% if net.sts_policy_document %}
    {{ "sts_policy_document".ljust(net.opt_pad) }} = <<-EOT
{{ net.sts_policy_document }}
EOT
{% endif %}
{% if net.kms_policy_document %}
    {{ "kms_policy_document".ljust(net.opt_pad) }} = <<-EOT
{{ net.kms_policy_document }}
EOT
{% endif %}
{% endif %}
{% if net.cross_region_s3_restore_sources_access %}

    cross_region_s3_restore_sources_access = [{% for r in net.cross_region_s3_restore_sources_access %}"{{ r }}"{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
  }
{% endfor %}
}
{% endif %}

{% if not infras %}
aws_infras = {}
{% else %}
aws_infras = {
{% for inf in infras %}
  "{{ inf.module_name }}" = {
    display_name         = "{{ inf.display_name }}"
    availability_zone_id = "{{ inf.availability_zone_id }}"
    shape                = "{{ inf.shape }}"
    compute_count        = {{ inf.compute_count }}
    storage_count        = {{ inf.storage_count }}
{% if inf.region %}
    region               = "{{ inf.region }}"
{% endif %}
{% if inf.availability_zone %}
    availability_zone    = "{{ inf.availability_zone }}"
{% endif %}
    mw_preference        = "{{ inf.mw_preference }}"
    mw_patching_mode     = "{{ inf.mw_patching_mode }}"
  }
{% endfor %}
}
{% endif %}

aws_peerings = {
{% for peer in peerings %}
  "{{ peer.module_name }}" = {
    display_name    = "{{ peer.display_name }}"
    network_ref     = "{{ peer.network_ref }}"
    peer_network_id = "{{ peer.peer_network_id }}"
{% if peer.region %}
    region          = "{{ peer.region }}"
{% endif %}
  }
{% endfor %}
}

aws_clusters = {
{% for cl in clusters %}
  "{{ cl.module_name }}" = {
    display_name                      = "{{ cl.display_name }}"
    gi_version                        = "{{ cl.gi_version }}"
    hostname_prefix                   = "{{ cl.hostname_prefix }}"
    infra_ref                         = "{{ cl.infra_ref }}"
    network_ref                       = "{{ cl.network_ref }}"
    cpu_core_count                    = {{ cl.cpu_core_count }}
    license_model                     = "{{ cl.license_model }}"
    ssh_public_keys                   = [{{ cl.ssh_public_keys | map("tojson") | join(", ") }}]
    db_servers_mode                   = "{{ cl.db_servers_mode }}"
{% if cl.db_servers %}
    db_servers                        = [{{ cl.db_servers | map("tojson") | join(", ") }}]
{% endif %}
    dco_is_diagnostics_events_enabled = {{ cl.dco_is_diagnostics_events_enabled | lower }}
    dco_is_health_monitoring_enabled  = {{ cl.dco_is_health_monitoring_enabled | lower }}
    dco_is_incident_logs_enabled      = {{ cl.dco_is_incident_logs_enabled | lower }}
{% if cl.cluster_name %}
    cluster_name                      = "{{ cl.cluster_name }}"
{% endif %}
{% if cl.timezone %}
    timezone                          = "{{ cl.timezone }}"
{% endif %}
{% if cl.data_storage_size_in_tbs is not none %}
    data_storage_size_in_tbs          = {{ cl.data_storage_size_in_tbs }}
{% endif %}
{% if cl.db_node_storage_size_in_gbs is not none %}
    db_node_storage_size_in_gbs       = {{ cl.db_node_storage_size_in_gbs }}
{% endif %}
{% if cl.memory_size_in_gbs is not none %}
    memory_size_in_gbs                = {{ cl.memory_size_in_gbs }}
{% endif %}
{% if cl.scan_listener_port_tcp is not none %}
    scan_listener_port_tcp            = {{ cl.scan_listener_port_tcp }}
{% endif %}
    is_local_backup_enabled           = {{ cl.is_local_backup_enabled | lower }}
    is_sparse_diskgroup_enabled       = {{ cl.is_sparse_diskgroup_enabled | lower }}
  }
{% endfor %}
}

{% if avmclusters %}
aws_avmclusters = {
{% for av in avmclusters %}
  "{{ av.module_name }}" = {
    display_name                          = "{{ av.display_name }}"
    infra_ref                             = "{{ av.infra_ref }}"
    network_ref                           = "{{ av.network_ref }}"
    autonomous_data_storage_size_in_tbs   = {{ av.autonomous_data_storage_size_in_tbs }}
    cpu_core_count_per_node               = {{ av.cpu_core_count_per_node }}
    memory_per_oracle_compute_unit_in_gbs = {{ av.memory_per_oracle_compute_unit_in_gbs }}
    total_container_databases             = {{ av.total_container_databases }}
    scan_listener_port_non_tls            = {{ av.scan_listener_port_non_tls }}
    scan_listener_port_tls                = {{ av.scan_listener_port_tls }}
    license_model                         = "{{ av.license_model }}"
    is_mtls_enabled_vm_cluster            = {{ av.is_mtls_enabled_vm_cluster | lower }}
    db_servers_mode                       = "{{ av.db_servers_mode }}"
{% if av.db_servers %}
    db_servers                            = [{{ av.db_servers | map("tojson") | join(", ") }}]
{% endif %}
{% if av.description %}
    description                           = "{{ av.description }}"
{% endif %}
{% if av.time_zone %}
    time_zone                             = "{{ av.time_zone }}"
{% endif %}
    mw_preference                         = "{{ av.mw_preference }}"
{% if av.mw_lead_time_in_weeks %}
    mw_lead_time_in_weeks                 = {{ av.mw_lead_time_in_weeks }}
{% endif %}
{% if av.mw_days_of_week %}
    mw_days_of_week                       = [{{ av.mw_days_of_week | map("tojson") | join(", ") }}]
{% endif %}
{% if av.mw_months %}
    mw_months                             = [{{ av.mw_months | map("tojson") | join(", ") }}]
{% endif %}
{% if av.mw_hours_of_day %}
    mw_hours_of_day                       = [{{ av.mw_hours_of_day | join(", ") }}]
{% endif %}
{% if av.mw_weeks_of_month %}
    mw_weeks_of_month                     = [{{ av.mw_weeks_of_month | join(", ") }}]
{% endif %}
  }
{% endfor %}
}
{% endif %}
{% if avmclusters_arn %}

# Infra and network referenced by ARN — created outside this configuration.
aws_avmclusters_arn = {
{% for av in avmclusters_arn %}
  "{{ av.module_name }}" = {
    display_name                          = "{{ av.display_name }}"
    cloud_exadata_infrastructure_arn      = "{{ av.cloud_exadata_infrastructure_arn }}"
    odb_network_arn                       = "{{ av.odb_network_arn }}"
    autonomous_data_storage_size_in_tbs   = {{ av.autonomous_data_storage_size_in_tbs }}
    cpu_core_count_per_node               = {{ av.cpu_core_count_per_node }}
    memory_per_oracle_compute_unit_in_gbs = {{ av.memory_per_oracle_compute_unit_in_gbs }}
    total_container_databases             = {{ av.total_container_databases }}
    scan_listener_port_non_tls            = {{ av.scan_listener_port_non_tls }}
    scan_listener_port_tls                = {{ av.scan_listener_port_tls }}
    license_model                         = "{{ av.license_model }}"
    is_mtls_enabled_vm_cluster            = {{ av.is_mtls_enabled_vm_cluster | lower }}
    db_servers_mode                       = "manual"
{% if av.db_servers %}
    db_servers                            = [{{ av.db_servers | map("tojson") | join(", ") }}]
{% endif %}
{% if av.description %}
    description                           = "{{ av.description }}"
{% endif %}
{% if av.time_zone %}
    time_zone                             = "{{ av.time_zone }}"
{% endif %}
    mw_preference                         = "{{ av.mw_preference }}"
{% if av.mw_lead_time_in_weeks %}
    mw_lead_time_in_weeks                 = {{ av.mw_lead_time_in_weeks }}
{% endif %}
{% if av.mw_days_of_week %}
    mw_days_of_week                       = [{{ av.mw_days_of_week | map("tojson") | join(", ") }}]
{% endif %}
{% if av.mw_months %}
    mw_months                             = [{{ av.mw_months | map("tojson") | join(", ") }}]
{% endif %}
{% if av.mw_hours_of_day %}
    mw_hours_of_day                       = [{{ av.mw_hours_of_day | join(", ") }}]
{% endif %}
{% if av.mw_weeks_of_month %}
    mw_weeks_of_month                     = [{{ av.mw_weeks_of_month | join(", ") }}]
{% endif %}
  }
{% endfor %}
}
{% endif %}
{% if adbs %}
{% if avmclusters or avmclusters_arn %}

{% endif %}
aws_autonomous_dbs = {
{% for a in adbs %}
  "{{ a.module_name }}" = {
{% for line in a.tfvars_lines %}
{% if line %}
    {{ line }}
{% else %}

{% endif %}
{% endfor %}
  }
{% endfor %}
}
{% if adbs | selectattr('admin_password_source', 'equalto', 'write_only') | list %}

# The ADMIN password is deliberately absent — never commit a password to a file.
# It is ephemeral, so it never reaches a plan file or state either. Set it in
# the shell that runs terraform; the value is just the password (12-30 chars):
#   macOS / Linux:  export TF_VAR_aws_adb_admin_password='...'
#   PowerShell:     $env:TF_VAR_aws_adb_admin_password = '...'
# A different password per database goes in TF_VAR_aws_adb_admin_passwords, an
# HCL map such as '{ {% for a in adbs if a.admin_password_source == 'write_only' %}{{ a.module_name }} = "..."{% if not loop.last %}, {% endif %}{% endfor %} }'.
{% endif %}
{% endif %}
