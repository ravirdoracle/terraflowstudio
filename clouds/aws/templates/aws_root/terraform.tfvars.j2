{% set ext_infras = external_infras | selectattr('existing_arn') | list %}
{% if ext_nets %}
existing_odb_network_arns = {
{% for n in ext_nets %}
  "{{ n.module_name }}" = "{{ n.existing_arn }}"
{% endfor %}
}

{% endif %}
{% if ext_infras %}
existing_infra_arns = {
{% for i in ext_infras %}
  "{{ i.module_name }}" = "{{ i.existing_arn }}"
{% endfor %}
}

{% endif %}
aws_ram_shares = {
{% for r in ram_shares %}
  "{{ r.module_name }}" = {
{% for line in r.tfvars_lines %}
    {{ line }}
{% endfor %}
  }
{% endfor %}
}
{% endif %}
