# main.tf — Generated by Terraflow Studio
# Root module — wires all ODB@AWS modules.
# Toolchain: {{ 'OpenTofu' if iac_tool == 'opentofu' else 'Terraform' }}
#
# Scale without re-generating: add entries to var.aws_networks, var.aws_infras,
# var.aws_peerings, or var.aws_clusters in terraform.auto.tfvars.

terraform {
  required_version = "{{ core_version }}"
  required_providers {
    aws = {
{% if iac_tool == 'opentofu' %}
      # OpenTofu resolves hashicorp/aws from registry.opentofu.org by default
{% endif %}
      source  = "hashicorp/aws"
      version = "{{ aws_provider_version }}"
    }
{% if oci_databases or kms_keys %}
    oci = {
      source  = "oracle/oci"
      version = "{{ oci_provider_version }}"
    }
{% endif %}
  }
}

provider "aws" {
  region = var.aws_region
}

{% if oci_databases or kms_keys %}
# ── OCI Provider (DB Home / CDB / PDB) ───────────────────────────────────────
provider "oci" {
  auth             = var.oci_auth_method
  region           = var.oci_region
  tenancy_ocid     = var.oci_auth_method == "APIKey" ? var.oci_tenancy_ocid : null
  user_ocid        = var.oci_auth_method == "APIKey" ? var.oci_user_ocid : null
  fingerprint      = var.oci_auth_method == "APIKey" ? var.oci_fingerprint : null
  private_key_path = var.oci_auth_method == "APIKey" ? var.oci_private_key_path : null
}
{% endif %}

# ── ODB Networks ──────────────────────────────────────────────────────────────
# To add another network: append an entry to aws_networks in terraform.auto.tfvars.
module "aws_odb_network" {
  source   = "./modules/aws-odb-network"
  for_each = var.aws_networks

  display_name                = each.value.display_name
  availability_zone_id        = each.value.availability_zone_id
  client_subnet_cidr          = each.value.client_subnet_cidr
  backup_subnet_cidr          = each.value.backup_subnet_cidr
  s3_access                   = each.value.s3_access
  zero_etl_access             = each.value.zero_etl_access
  availability_zone           = each.value.availability_zone
  region                      = each.value.region
  custom_domain_name          = each.value.custom_domain_name
  default_dns_prefix          = each.value.default_dns_prefix
  delete_associated_resources = each.value.delete_associated_resources
  tags                        = var.tags

  # Kept in their own runs so terraform fmt does not widen the block above to
  # the length of cross_region_s3_restore_sources_access.
  sts_access          = each.value.sts_access
  kms_access          = each.value.kms_access
  s3_policy_document  = each.value.s3_policy_document
  sts_policy_document = each.value.sts_policy_document
  kms_policy_document = each.value.kms_policy_document

  cross_region_s3_restore_sources_access = each.value.cross_region_s3_restore_sources_access
}

# ── Exadata Infrastructures ───────────────────────────────────────────────────
# To add another infra: append an entry to aws_infras in terraform.auto.tfvars.
module "aws_exadata_infra" {
  source   = "./modules/aws-exadata-infra"
  for_each = var.aws_infras

  display_name                        = each.value.display_name
  shape                               = each.value.shape
  compute_count                       = each.value.compute_count
  storage_count                       = each.value.storage_count
  availability_zone_id                = each.value.availability_zone_id
  availability_zone                   = each.value.availability_zone
  region                              = each.value.region
  database_server_type                = each.value.database_server_type
  storage_server_type                 = each.value.storage_server_type
  customer_contacts                   = each.value.customer_contacts
  mw_preference                       = each.value.mw_preference
  mw_patching_mode                    = each.value.mw_patching_mode
  mw_is_custom_action_timeout_enabled = each.value.mw_is_custom_action_timeout_enabled
  mw_custom_action_timeout_in_mins    = each.value.mw_custom_action_timeout_in_mins
  mw_lead_time_in_weeks               = each.value.mw_lead_time_in_weeks
  mw_days_of_week                     = each.value.mw_days_of_week
  mw_months                           = each.value.mw_months
  mw_hours_of_day                     = each.value.mw_hours_of_day
  mw_weeks_of_month                   = each.value.mw_weeks_of_month
  tags                                = var.tags
}

{% if external_infras or external_networks %}
# ── Externally provisioned resources ──────────────────────────────────────────
# Resources created outside this configuration are referenced by ID. Managed
# instances and external IDs share one keyspace, so infra_ref / network_ref keep
# working whichever side a resource lives on.
locals {
{% if external_infras %}
  infra_ids = merge(
    { for k, m in module.aws_exadata_infra : k => m.infra_id },
    var.existing_infra_ids,
  )
{% endif %}
{% if external_networks %}
  odb_network_ids = merge(
    { for k, m in module.aws_odb_network : k => m.network_id },
    var.existing_odb_network_ids,
  )
{% endif %}
}

{% endif %}
# ── DB Server IDs ─────────────────────────────────────────────────────────────
# Discovered per cluster from the Exadata Infrastructure, for every cluster that
# did not list its servers by hand.
data "aws_odb_db_servers" "this" {
  depends_on                      = [module.aws_exadata_infra]
  for_each                        = { for k, v in var.aws_clusters : k => v if v.db_servers_mode != "manual" }
  cloud_exadata_infrastructure_id = {{ infra_id_expr }}
}

# A DB server hosts one VM per cluster and reports allocated-vs-total capacity
# (cpu_core_count/max_cpu_count, memory_size_in_gbs/max_memory_in_gbs), and
# vm_cluster_ids is a list — so a server another cluster already sits on is
# still usable while it has room. "auto" therefore offers every server on the
# infrastructure. "unallocated" narrows to servers no cluster holds yet, for
# putting a cluster on hardware of its own.
locals {
  # Keyed only by the clusters that asked for discovery.
  discovered_db_servers = {
    for k, d in data.aws_odb_db_servers.this : k => (
      var.aws_clusters[k].db_servers_mode == "unallocated"
      ? [for s in d.db_servers : s.id if length(s.vm_cluster_ids) == 0 && length(s.autonomous_vm_cluster_ids) == 0]
      : d.db_servers[*].id
    )
  }

  # Every cluster, discovery or hand-written list.
  cluster_db_servers = {
    for k, v in var.aws_clusters : k => lookup(local.discovered_db_servers, k, v.db_servers)
  }
}

# db_servers is required, so an empty list fails at the API with something far
# less obvious than this.
check "unallocated_db_servers_available" {
  assert {
    condition = alltrue([
      for k, v in local.discovered_db_servers : length(v) > 0
      if var.aws_clusters[k].db_servers_mode == "unallocated"
    ])
    error_message = format(
      "No unallocated DB servers left on the infrastructure for these clusters: %s. Every server already hosts a VM cluster. Servers are shared — use db_servers_mode = \"auto\" to place the cluster on them anyway, as long as each has capacity left, or \"manual\" to choose the servers yourself.",
      join(", ", [
        for k, v in local.discovered_db_servers : k
        if length(v) == 0 && var.aws_clusters[k].db_servers_mode == "unallocated"
      ]),
    )
  }
}

# ── Network Peerings ──────────────────────────────────────────────────────────
# To add another peering: append an entry to aws_peerings in terraform.auto.tfvars.
module "aws_peering" {
  source   = "./modules/aws-peering"
  for_each = var.aws_peerings

  display_name    = each.value.display_name
  odb_network_id  = {{ network_id_expr }}
  peer_network_id = each.value.peer_network_id
  region          = each.value.region
  tags            = var.tags

  depends_on = [module.aws_odb_network]
}

# ── VM Clusters ───────────────────────────────────────────────────────────────
# To add another cluster: append an entry to aws_clusters in terraform.auto.tfvars.
module "aws_vm_cluster" {
  source   = "./modules/aws-vm-cluster"
  for_each = var.aws_clusters

  display_name                      = each.value.display_name
  cpu_core_count                    = each.value.cpu_core_count
  gi_version                        = each.value.gi_version
  hostname_prefix                   = each.value.hostname_prefix
  license_model                     = each.value.license_model
  ssh_public_keys                   = each.value.ssh_public_keys
  cloud_exadata_infrastructure_id   = {{ infra_id_expr }}
  odb_network_id                    = {{ network_id_expr }}
  db_servers                        = local.cluster_db_servers[each.key]
  dco_is_diagnostics_events_enabled = each.value.dco_is_diagnostics_events_enabled
  dco_is_health_monitoring_enabled  = each.value.dco_is_health_monitoring_enabled
  dco_is_incident_logs_enabled      = each.value.dco_is_incident_logs_enabled
  cluster_name                      = each.value.cluster_name
  timezone                          = each.value.timezone
  data_storage_size_in_tbs          = each.value.data_storage_size_in_tbs
  db_node_storage_size_in_gbs       = each.value.db_node_storage_size_in_gbs
  memory_size_in_gbs                = each.value.memory_size_in_gbs
  scan_listener_port_tcp            = each.value.scan_listener_port_tcp
  is_local_backup_enabled           = each.value.is_local_backup_enabled
  is_sparse_diskgroup_enabled       = each.value.is_sparse_diskgroup_enabled
  tags                              = var.tags

  depends_on = [
    module.aws_odb_network,
    module.aws_exadata_infra,
  ]
}

{% if avmclusters %}
# ── Autonomous VM Clusters ────────────────────────────────────────────────────
# To add another AVMC: append an entry to aws_avmclusters in terraform.auto.tfvars.
# DB servers are discovered the same way as for the VM clusters above — "auto"
# offers every server on the infrastructure, "unallocated" only the ones no
# cluster holds yet.
data "aws_odb_db_servers" "avmc" {
  depends_on                      = [module.aws_exadata_infra]
  for_each                        = { for k, v in var.aws_avmclusters : k => v if v.db_servers_mode != "manual" }
  cloud_exadata_infrastructure_id = {{ infra_id_expr }}
}

locals {
  avmc_discovered_db_servers = {
    for k, d in data.aws_odb_db_servers.avmc : k => (
      var.aws_avmclusters[k].db_servers_mode == "unallocated"
      ? [for s in d.db_servers : s.id if length(s.vm_cluster_ids) == 0 && length(s.autonomous_vm_cluster_ids) == 0]
      : d.db_servers[*].id
    )
  }

  avmc_db_servers = {
    for k, v in var.aws_avmclusters : k => lookup(local.avmc_discovered_db_servers, k, v.db_servers)
  }
}

check "unallocated_avmc_db_servers_available" {
  assert {
    condition = alltrue([
      for k, v in local.avmc_discovered_db_servers : length(v) > 0
      if var.aws_avmclusters[k].db_servers_mode == "unallocated"
    ])
    error_message = format(
      "No unallocated DB servers left on the infrastructure for these Autonomous VM clusters: %s. Every server already hosts a cluster. Servers are shared — use db_servers_mode = \"auto\" to place the cluster on them anyway, as long as each has capacity left, or \"manual\" to choose the servers yourself.",
      join(", ", [
        for k, v in local.avmc_discovered_db_servers : k
        if length(v) == 0 && var.aws_avmclusters[k].db_servers_mode == "unallocated"
      ]),
    )
  }
}

module "aws_avmcluster" {
  source   = "./modules/aws-avmcluster"
  for_each = var.aws_avmclusters

  display_name                          = each.value.display_name
  autonomous_data_storage_size_in_tbs   = each.value.autonomous_data_storage_size_in_tbs
  cpu_core_count_per_node               = each.value.cpu_core_count_per_node
  memory_per_oracle_compute_unit_in_gbs = each.value.memory_per_oracle_compute_unit_in_gbs
  total_container_databases             = each.value.total_container_databases
  scan_listener_port_non_tls            = each.value.scan_listener_port_non_tls
  scan_listener_port_tls                = each.value.scan_listener_port_tls
  license_model                         = each.value.license_model
  is_mtls_enabled_vm_cluster            = each.value.is_mtls_enabled_vm_cluster
  description                           = each.value.description
  time_zone                             = each.value.time_zone

  cloud_exadata_infrastructure_id = {{ infra_id_expr }}
  odb_network_id                  = {{ network_id_expr }}

  db_servers = local.avmc_db_servers[each.key]

  mw_preference         = each.value.mw_preference
  mw_lead_time_in_weeks = each.value.mw_lead_time_in_weeks
  mw_days_of_week       = each.value.mw_days_of_week
  mw_months             = each.value.mw_months
  mw_hours_of_day       = each.value.mw_hours_of_day
  mw_weeks_of_month     = each.value.mw_weeks_of_month

  tags = var.tags

  depends_on = [module.aws_odb_network, module.aws_exadata_infra]
}

{% endif %}
{% if avmclusters_arn %}
# ── Autonomous VM Clusters — ARN pair ─────────────────────────────────────────
# Infra and network referenced by ARN, for resources in another account or
# stack. Separate module because the provider rejects a config carrying both
# pairs, and a null attribute still counts as present.
module "aws_avmcluster_arn" {
  source   = "./modules/aws-avmcluster-arn"
  for_each = var.aws_avmclusters_arn

  display_name                          = each.value.display_name
  autonomous_data_storage_size_in_tbs   = each.value.autonomous_data_storage_size_in_tbs
  cpu_core_count_per_node               = each.value.cpu_core_count_per_node
  memory_per_oracle_compute_unit_in_gbs = each.value.memory_per_oracle_compute_unit_in_gbs
  total_container_databases             = each.value.total_container_databases
  scan_listener_port_non_tls            = each.value.scan_listener_port_non_tls
  scan_listener_port_tls                = each.value.scan_listener_port_tls
  license_model                         = each.value.license_model
  is_mtls_enabled_vm_cluster            = each.value.is_mtls_enabled_vm_cluster
  description                           = each.value.description
  time_zone                             = each.value.time_zone

  cloud_exadata_infrastructure_arn = each.value.cloud_exadata_infrastructure_arn
  odb_network_arn                  = each.value.odb_network_arn

  # No auto-discovery here: the infra lives outside this configuration, so there
  # is no id to hand data.aws_odb_db_servers. List the servers explicitly.
  db_servers = each.value.db_servers

  mw_preference         = each.value.mw_preference
  mw_lead_time_in_weeks = each.value.mw_lead_time_in_weeks
  mw_days_of_week       = each.value.mw_days_of_week
  mw_months             = each.value.mw_months
  mw_hours_of_day       = each.value.mw_hours_of_day
  mw_weeks_of_month     = each.value.mw_weeks_of_month

  tags = var.tags
}

{% endif %}
{% if adb_integration %}
# ── AWS Secrets Manager integration (account + Region) ────────────────────────
# One per AWS account and Region, shared by every Autonomous Database there.
# prevent_destroy is set in the module: a destroy would disable Secrets Manager
# passwords for databases outside this configuration too.
module "aws_adb_secrets_integration" {
  source = "./modules/aws-adb-secrets-integration"
}

{% endif %}
{% if adbs %}
# ── Autonomous Databases (Serverless) ─────────────────────────────────────────
# To add another ADB: append an entry to aws_autonomous_dbs in
# terraform.auto.tfvars. A write_only database uses TF_VAR_aws_adb_admin_password,
# or its own entry in TF_VAR_aws_adb_admin_passwords.
# Serverless: Oracle runs the Exadata fleet, so this needs an ODB Network and
# nothing else — no Exadata Infrastructure, no Autonomous VM Cluster.
module "aws_autonomous_db" {
  source   = "./modules/aws-autonomous-db"
  for_each = var.aws_autonomous_dbs

  display_name             = each.value.display_name
  db_name                  = each.value.db_name
  odb_network_id           = {{ network_id_expr }}
  db_workload              = each.value.db_workload
  license_model            = each.value.license_model
  compute_count            = each.value.compute_count
  data_storage_size_in_tbs = each.value.data_storage_size_in_tbs

  database_edition                     = each.value.database_edition
  db_version                           = each.value.db_version
  is_auto_scaling_enabled              = each.value.is_auto_scaling_enabled
  is_auto_scaling_for_storage_enabled  = each.value.is_auto_scaling_for_storage_enabled
  backup_retention_period_in_days      = each.value.backup_retention_period_in_days
  autonomous_maintenance_schedule_type = each.value.autonomous_maintenance_schedule_type
  is_mtls_connection_required          = each.value.is_mtls_connection_required
  private_endpoint_label               = each.value.private_endpoint_label
  private_endpoint_ip                  = each.value.private_endpoint_ip
  allowlisted_ips                      = each.value.allowlisted_ips
  character_set                        = each.value.character_set
  ncharacter_set                       = each.value.ncharacter_set
  encryption_key_provider              = each.value.encryption_key_provider
  kms_key_id                           = each.value.kms_key_id
  customer_contacts                    = each.value.customer_contacts

  # A per-database entry in aws_adb_admin_passwords wins; otherwise the single
  # aws_adb_admin_password applies. Missing both, it arrives as null and the
  # module's precondition stops the plan with instructions.
  admin_password_source     = each.value.admin_password_source
  admin_password_wo         = each.value.admin_password_source == "write_only" ? lookup(var.aws_adb_admin_passwords, each.key, var.aws_adb_admin_password) : null
  admin_password_wo_version = each.value.admin_password_wo_version
  secret_arn                = each.value.secret_arn
  secret_iam_role_arn       = each.value.secret_iam_role_arn
  secret_external_id_type   = each.value.secret_external_id_type

  tags = var.tags

{% if adb_integration %}
  depends_on = [module.aws_odb_network, module.aws_adb_secrets_integration]
{% else %}
  depends_on = [module.aws_odb_network]
{% endif %}
}

{% endif %}
{% if ram_shares %}
# ── AWS RAM resource shares ───────────────────────────────────────────────────
# To share with another account, or share another resource: edit aws_ram_shares
# in terraform.auto.tfvars. network_refs / infra_refs are the same keys the
# clusters use; an externally provisioned one resolves through its ARN.
# Prerequisite, once, from the Organization's management account:
#   aws ram enable-sharing-with-aws-organization
locals {
  ram_network_arns = merge(
    { for k, m in module.aws_odb_network : k => m.network_arn },
    var.existing_odb_network_arns,
  )
  ram_infra_arns = merge(
    { for k, m in module.aws_exadata_infra : k => m.infra_arn },
    var.existing_infra_arns,
  )
}

module "aws_ram_share" {
  source   = "./modules/aws-ram-share"
  for_each = var.aws_ram_shares

  name                      = each.value.name
  principals                = each.value.principals
  allow_external_principals = each.value.allow_external_principals

  # Keyed by name so the keys are known at plan time, before the ARNs are.
  resource_arns = merge(
    { for r in each.value.network_refs : "odb-network/${r}" => local.ram_network_arns[r] },
    { for r in each.value.infra_refs : "exadata-infrastructure/${r}" => local.ram_infra_arns[r] },
    { for a in each.value.resource_arns : a => a },
  )

  tags = var.tags
}

{% endif %}
{% if kms_keys %}
# ── TDE master keys in AWS KMS ────────────────────────────────────────────────
# Each key in aws_kms_keys is created (or adopted by existing_arn), each of its
# cluster_refs gets an IAM role the cluster assumes through the OCI identity
# domain's OIDC provider plus a KmsTde association, and the key is registered in
# OCI through the identity connector that association attaches. Its oci_key_id
# output is what a CDB's encryption_key_location_details takes.
#
# One step is manual — no provider exposes it: OCI console > Exadata VM Cluster >
# VM Cluster information > "AWS Key Management" > Enable. Do it before a
# database uses a key.

# Exactly one OIDC provider source; a check block would only warn.
data "aws_caller_identity" "kms" {
  lifecycle {
    precondition {
      condition     = (var.aws_kms_oidc_provider_arn != "") != (var.aws_kms_oidc_provider_url != "")
      error_message = "Set exactly one of aws_kms_oidc_provider_arn (reuse the account's provider for the OCI identity domain) or aws_kms_oidc_provider_url (create it)."
    }
  }
}

resource "aws_iam_openid_connect_provider" "oci_identity_domain" {
  count = var.aws_kms_oidc_provider_url != "" ? 1 : 0

  url            = var.aws_kms_oidc_provider_url
  client_id_list = [var.aws_kms_oidc_audience]
  tags           = var.tags

  lifecycle {
    precondition {
      condition     = var.aws_kms_oidc_audience != ""
      error_message = "A new OIDC provider needs the identity domain's token audience: set aws_kms_oidc_audience."
    }
  }
}

data "aws_iam_openid_connect_provider" "oci_identity_domain" {
  count = var.aws_kms_oidc_provider_arn != "" ? 1 : 0
  arn   = var.aws_kms_oidc_provider_arn

  # A provider that does not list the audience rejects the token before the
  # trust policy is consulted. A shared provider is its owner's to change.
  lifecycle {
    postcondition {
      condition     = var.aws_kms_oidc_audience == "" || contains(self.client_id_list, var.aws_kms_oidc_audience)
      error_message = "The OIDC provider does not list aws_kms_oidc_audience in its client IDs."
    }
  }
}

locals {
  kms_oidc_provider_arn = var.aws_kms_oidc_provider_arn != "" ? var.aws_kms_oidc_provider_arn : one(aws_iam_openid_connect_provider.oci_identity_domain[*].arn)
  kms_oidc_provider_host = trimprefix(
    var.aws_kms_oidc_provider_arn != "" ? one(data.aws_iam_openid_connect_provider.oci_identity_domain[*].url) : var.aws_kms_oidc_provider_url,
    "https://",
  )

  # cluster -> key. A cluster takes one key; the variable's validation rejects
  # a cluster named by two.
  kms_cluster_keys = merge({}, [
    for k, v in var.aws_kms_keys : { for c in v.cluster_refs : c => k }
  ]...)
  kms_key_arns = {
    for k, v in var.aws_kms_keys : k => v.existing_arn != "" ? v.existing_arn : module.aws_kms_key[k].key_arn
  }
  kms_register_via = {
    for k, v in var.aws_kms_keys : k => v.register_via != "" ? v.register_via : v.cluster_refs[0]
  }
}

module "aws_kms_key" {
  source   = "./modules/aws-kms-key"
  for_each = { for k, v in var.aws_kms_keys : k => v if v.existing_arn == "" }

  alias                   = each.value.alias
  description             = "TDE master encryption key for Oracle AI Database@AWS"
  deletion_window_in_days = each.value.deletion_window_in_days
  multi_region            = each.value.multi_region
  enable_key_rotation     = each.value.enable_key_rotation
  account_id              = data.aws_caller_identity.kms.account_id
  tags                    = var.tags
}

module "aws_kms_cluster_access" {
  source   = "./modules/aws-kms-cluster-access"
  for_each = local.kms_cluster_keys

  role_name               = "OracleDBKMS-${each.key}"
  oidc_provider_arn       = local.kms_oidc_provider_arn
  oidc_provider_host      = local.kms_oidc_provider_host
  vm_cluster_arn          = module.aws_vm_cluster[each.key].vm_cluster_arn
  vm_cluster_ocid         = module.aws_vm_cluster[each.key].ocid
  isolate_role_to_cluster = var.aws_kms_isolate_role_to_cluster
  audience                = var.aws_kms_oidc_audience
  kms_key_arn             = local.kms_key_arns[each.value]
  tags                    = var.tags
}

# Read after the association: that is when OCI attaches the identity connector.
data "oci_database_cloud_vm_cluster" "kms" {
  for_each            = local.kms_cluster_keys
  cloud_vm_cluster_id = module.aws_vm_cluster[each.key].ocid

  depends_on = [module.aws_kms_cluster_access]
}

module "aws_kms_oci_key" {
  source   = "./modules/aws-kms-oci-key"
  for_each = var.aws_kms_keys

  display_name   = trimprefix(each.value.alias, "alias/")
  compartment_id = each.value.oci_compartment_id != "" ? each.value.oci_compartment_id : data.oci_database_cloud_vm_cluster.kms[local.kms_register_via[each.key]].compartment_id
  aws_key_arn    = local.kms_key_arns[each.key]
  identity_connector_id = try(one([
    for c in data.oci_database_cloud_vm_cluster.kms[local.kms_register_via[each.key]].multi_cloud_identity_connector_configs :
    c.id if can(regex("(?i)aws|amazon", c.cloud_provider))
  ]), "")
  via_cluster   = local.kms_register_via[each.key]
  freeform_tags = var.tags

  depends_on = [module.aws_kms_cluster_access, module.aws_kms_key]
}

resource "oci_identity_policy" "aws_kms_keys" {
  count = var.aws_kms_oci_policy_compartment_id != "" ? 1 : 0

  compartment_id = var.aws_kms_oci_policy_compartment_id
  name           = "oracle-db-aws-keys"
  description    = "Lets Oracle AI Database@AWS VM clusters read their registered AWS KMS keys."
  statements = [
    for c in distinct(concat(
      [for k, m in module.aws_kms_oci_key : m.compartment_id],
      [for k, d in data.oci_database_cloud_vm_cluster.kms : d.compartment_id],
    )) :
    "Allow any-user to read oracle-db-aws-keys in compartment id ${c} where all { request.principal.type = 'cloudvmcluster' }"
  ]
}

{% endif %}
{% for db in oci_databases %}
# ── OCI DB: {{ db.module_name }} — Step 1: DB Home ───────────────────────────
module "{{ db.module_name }}_dbhome" {
  source          = "./modules/{{ db.module_name }}_dbhome"
  vm_cluster_ocid = module.aws_vm_cluster["{{ db.vmcluster_ref }}"].ocid
  depends_on      = [module.aws_vm_cluster]
}

# ── OCI DB: {{ db.module_name }} — Step 2: CDB ───────────────────────────────
module "{{ db.module_name }}_cdb" {
  source         = "./modules/{{ db.module_name }}_cdb"
  db_home_id     = module.{{ db.module_name }}_dbhome.db_home_id
  admin_password = var.{{ db.module_name }}_admin_password
  depends_on     = [module.{{ db.module_name }}_dbhome]
}

{% if db.create_pdb and db.pdb_name %}
# ── OCI DB: {{ db.module_name }} — Step 3: PDB ───────────────────────────────
module "{{ db.module_name }}_pdb" {
  source                = "./modules/{{ db.module_name }}_pdb"
  container_database_id = module.{{ db.module_name }}_cdb.cdb_id
  pdb_admin_password    = var.{{ db.module_name }}_admin_password
  depends_on            = [module.{{ db.module_name }}_cdb]
}
{% endif %}

output "{{ db.module_name }}_db_home_id" { value = module.{{ db.module_name }}_dbhome.db_home_id }
output "{{ db.module_name }}_cdb_id"     { value = module.{{ db.module_name }}_cdb.cdb_id }
{% if db.create_pdb and db.pdb_name %}
output "{{ db.module_name }}_pdb_id" { value = module.{{ db.module_name }}_pdb.pdb_id }
{% endif %}

{% endfor %}
# ── Outputs ────────────────────────────────────────────────────────────────────
output "odb_networks" {
  description = "ODB Network details keyed by instance name."
  value = { for k, v in module.aws_odb_network : k => {
    network_id  = v.network_id
    network_arn = v.network_arn
  } }
}

output "exadata_infras" {
  description = "Exadata Infrastructure details keyed by instance name."
  value = { for k, v in module.aws_exadata_infra : k => {
    infra_id  = v.infra_id
    infra_arn = v.infra_arn
  } }
}

output "peerings" {
  description = "Network Peering details keyed by instance name."
  value = { for k, v in module.aws_peering : k => {
    peering_connection_id = v.peering_connection_id
  } }
}

output "vm_clusters" {
  description = "VM Cluster details keyed by instance name."
  value = { for k, v in module.aws_vm_cluster : k => {
    vm_cluster_id = v.vm_cluster_id
    ocid          = v.ocid
  } }
}

output "db_servers" {
  description = "DB Server IDs per cluster, keyed by cluster instance name."
  value       = { for k, v in data.aws_odb_db_servers.this : k => v.db_servers[*].id }
}
{% if avmclusters %}

output "autonomous_vm_clusters" {
  description = "Autonomous VM Cluster details keyed by instance name."
  value = { for k, v in module.aws_avmcluster : k => {
    avmc_id   = v.avmc_id
    avmc_arn  = v.avmc_arn
    avmc_ocid = v.avmc_ocid
  } }
}
{% endif %}
{% if avmclusters_arn %}

output "autonomous_vm_clusters_arn" {
  description = "Autonomous VM Cluster details for ARN-referenced instances, keyed by instance name."
  value = { for k, v in module.aws_avmcluster_arn : k => {
    avmc_id   = v.avmc_id
    avmc_arn  = v.avmc_arn
    avmc_ocid = v.avmc_ocid
  } }
}
{% endif %}
{% if adbs %}

output "autonomous_databases" {
  description = "Autonomous Database (Serverless) details keyed by instance name."
  value = { for k, v in module.aws_autonomous_db : k => {
    adb_id           = v.adb_id
    adb_arn          = v.adb_arn
    adb_ocid         = v.adb_ocid
    private_endpoint = v.private_endpoint
  } }
}
{% endif %}
{% if adb_integration %}

output "adb_secrets_manager_service_role_arn" {
  description = "Oracle-managed service role. Your IAM role for the ADMIN-password secret must trust this ARN."
  value       = module.aws_adb_secrets_integration.role_arn
}
{% endif %}
{% if ram_shares %}

output "ram_resource_shares" {
  description = "AWS RAM resource share ARNs keyed by share name."
  value       = { for k, v in module.aws_ram_share : k => v.share_arn }
}
{% endif %}
{% if kms_keys %}

output "aws_kms_keys" {
  description = "TDE keys keyed by name. oci_key_id is what a CDB's encryption_key_location_details.aws_encryption_key_id takes."
  value = { for k, v in var.aws_kms_keys : k => {
    kms_key_arn = local.kms_key_arns[k]
    oci_key_id  = module.aws_kms_oci_key[k].id
    clusters = { for c in v.cluster_refs : c => {
      role_arn           = module.aws_kms_cluster_access[c].role_arn
      association_status = module.aws_kms_cluster_access[c].association_status
      # Changes once "AWS Key Management" is enabled on the cluster in OCI.
      tde_key_store_type = data.oci_database_cloud_vm_cluster.kms[c].tde_key_store_type
    } }
  } }
}
{% endif %}
