# Copy to .env. Keep .env private; it is excluded from Git and the image build.
# Leave AI and GitHub settings blank to use Terraform generation without them.
# Set BOTH credentials before making the app reachable through a network IP.
APP_AUTH_USER=admin
APP_AUTH_PASSWORD=

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Optional semantic RAG. Blank uses the built-in BM25 search.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

# Optional: push generated Terraform files to GitHub.
# These settings are independent of container-registry publishing.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_BASE_PATH=terraform

# Optional CouchDB. Blank uses /app/data in the container.
COUCHDB_URL=
COUCHDB_USER=admin
COUCHDB_PASSWORD=
COUCHDB_DB=terraflow_studio_configs
